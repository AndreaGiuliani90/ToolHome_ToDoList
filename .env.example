# Copia questo file in `.env` (in locale) o imposta le variabili su Railway.

# --- Login Google (obbligatorio in produzione) ---
# Client ID OAuth 2.0 da https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Email admin (separate da virgola): approvate automaticamente al primo login
ADMIN_EMAILS=andrea.giuliani@accyourate.com

# Segreto per firmare i cookie di sessione (stringa lunga casuale).
# Se manca, ne viene generato uno a ogni riavvio e le sessioni si azzerano.
SESSION_SECRET=

# --- Intelligenza artificiale (opzionale ma consigliato) ---
# Senza chiave l'app funziona con una classificazione euristica di base.
ANTHROPIC_API_KEY=
# Modello da usare per la classificazione (default: claude-opus-5)
# Alternativa più economica: claude-haiku-4-5
AI_MODEL=claude-opus-5

# --- Database ---
# In locale non serve nulla: viene usato un file SQLite (data.sqlite).
# Su Railway aggiungi un servizio Postgres: DATABASE_URL viene impostata da Railway.
# DATABASE_URL=
